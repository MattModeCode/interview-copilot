# Panes. "claude:<alias>" uses a warm `claude` CLI process -- no API key, it
# uses your existing subscription login. "gemini" uses the Google SDK and does
# need GEMINI_API_KEY (Google discontinued the Gemini CLI's free OAuth tier).
PANE_A=claude:sonnet
PANE_B=claude:haiku
CLAUDE_BIN=claude
RECYCLE_AFTER=8

# Only needed if you set a pane to "gemini".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Audio input index from: ffmpeg -f avfoundation -list_devices true -i ""
AUDIO_DEVICE=1

# How far back the trigger looks, in seconds.
WINDOW_SECONDS=90
CHUNK_SECONDS=3

WHISPER_MODEL=models/ggml-large-v3-turbo.bin
HOTKEY_ENABLED=1
PORT=8477

# Per-interview domain brief. See domain.md.example for the format; copy it
# to domain.md (gitignored) and fill in the actual interview's subject
# matter and likely STT mishearings. Empty by default -- the tool works
# fine without one, this just sharpens question detection and vocabulary.
DOMAIN_CONTEXT=
