# Claude pane. Without this it falls back to the `claude` CLI, which costs
# ~5s of process startup per trigger -- fine for testing, bad mid-interview.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini pane.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Audio input index from: ffmpeg -f avfoundation -list_devices true -i ""
AUDIO_DEVICE=1

# How far back the trigger looks, in seconds.
WINDOW_SECONDS=90
CHUNK_SECONDS=3

WHISPER_MODEL=models/ggml-large-v3-turbo.bin
HOTKEY_ENABLED=1
PORT=8477
