# ---------------------------------------------------------------------------
# Answering backend. Two options, same behaviour, pick one.
#
#   api   Anthropic Messages API. Needs ANTHROPIC_API_KEY below. This is the
#         default and what you want unless you specifically have the Claude
#         CLI installed and logged in.
#   cli   A warm `claude` CLI session on an existing Claude subscription
#         login. No API key, but it burns your subscription's session
#         allowance and needs the CLI on PATH.
# ---------------------------------------------------------------------------
BACKEND=api

# BACKEND=api only. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# BACKEND=cli only. `claude` is resolved from PATH; set CLAUDE_BIN only if it
# lives somewhere your shell cannot see. You must already be logged in (run
# `claude` once on its own). RECYCLE_AFTER costs one spare turn each time it
# fires -- don't lower it.
CLAUDE_MODEL=sonnet
# CLAUDE_BIN=
RECYCLE_AFTER=8

# Audio input index from: ffmpeg -f avfoundation -list_devices true -i ""
AUDIO_DEVICE=1

# How far back the trigger looks, in seconds.
WINDOW_SECONDS=90

# Speech to text: faster-whisper, in process. The model downloads on first
# use (~1.5GB) and is cached, so run preflight.sh well before the call.
STT_MODEL=large-v3-turbo
STT_COMPUTE=int8

# Endpointing. Audio is cut where the speaker pauses, not on a timer.
# Lower SILENCE_HOLD_MS for less tail lag at the cost of mid-sentence cuts.
SILENCE_HOLD_MS=600
SEGMENT_MAX_SECONDS=14
HOTKEY_ENABLED=1
PORT=8477

# Per-interview domain brief. See domain.md.example for the format; copy it
# to domain.md (gitignored) and fill in the actual interview's subject
# matter and likely STT mishearings. Empty by default -- the tool works
# fine without one, this just sharpens question detection and vocabulary.
DOMAIN_CONTEXT=
